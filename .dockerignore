# Python virtual environment — never copy this, Docker installs its own
.venv/
venv/
env/

# Git history and CI configs — not needed in image
.git/
.github/
.gitignore

# Sensitive secrets — injected at runtime via Secrets Manager or env_file, never baked into image
.env
.envrc
credentials.json

# Lambda deployment packages
lambda_package/
lambda_deployment.zip
*.zip

# Temp and generated data — Docker uses named volumes for these
data/input/
data/output/
data/temp/
logs/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Test files
test/

# IDE configs
.vscode/
.idea/

# Docs and markdown (not needed at runtime)
*.md

# DevOps & Deployment scripts (not needed inside worker container)
scripts/
deploy_worker.*
build_lambda.*
requirements_lambda.txt
lambda_api.py
register_webhook.py
docker-compose*.yml

# Scratch response files
response*.json

# MoviePy temp files
*TEMP_MPY*
